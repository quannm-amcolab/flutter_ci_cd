# Fastfile cho Android build với Flutter
default_platform(:android)

platform :android do
  desc "Build Android APK"
  lane :build_apk do
    # Đảm bảo Flutter dependencies được cài đặt
    sh("cd #{lane_context[SharedValues::ROOT]} && flutter pub get")
    
    # Clean build trước
    sh("cd #{lane_context[SharedValues::ROOT]} && flutter clean")
    
    # Build APK release
    sh("cd #{lane_context[SharedValues::ROOT]} && flutter build apk --release")
    
    # APK sẽ được tạo tại: build/app/outputs/flutter-apk/app-release.apk
    apk_path = lane_context[SharedValues::ROOT] + "/build/app/outputs/flutter-apk/app-release.apk"
    
    UI.success("✅ APK đã được build thành công tại: #{apk_path}")
    
    # Trả về đường dẫn APK
    return apk_path
  end

  desc "Build Android APK với version name và build number"
  lane :build_apk_versioned do |options|
    version_name = options[:version_name] || "1.0.0"
    build_number = options[:build_number] || "1"
    
    # Build với version cụ thể
    sh("cd #{lane_context[SharedValues::ROOT]} && flutter build apk --release --build-name=#{version_name} --build-number=#{build_number}")
    
    apk_path = lane_context[SharedValues::ROOT] + "/build/app/outputs/flutter-apk/app-release.apk"
    
    UI.success("✅ APK version #{version_name} (#{build_number}) đã được build tại: #{apk_path}")
    
    return apk_path
  end

  desc "Build và upload APK (có thể mở rộng để upload lên Firebase App Distribution, Play Store, etc.)"
  lane :build_and_upload do |options|
    apk_path = build_apk
    
    # Có thể thêm logic upload ở đây
    # Ví dụ: upload_to_firebase_app_distribution, upload_to_play_store, etc.
    
    UI.message("📦 APK sẵn sàng để upload: #{apk_path}")
    
    return apk_path
  end
end

